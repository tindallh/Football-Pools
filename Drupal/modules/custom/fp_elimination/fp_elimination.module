<?php
/**
 * @file
 * Hooks for the FP Elimination Pools module.
 */

use Drupal\Core\Form\FormStateInterface;

function fp_elimination_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.fp_elimination':
      return t('Provides elimination pools for NCAA and NFL.');
  }
  return NULL;
}

function fp_elimination_pick_form(array $form, FormStateInterface $form_state) {
  $form['message'] = [
    '#markup' => t('This form will allow users to make elimination pool picks.'),
  ];
  return $form;
}
